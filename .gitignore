# macOS and editor metadata
.DS_Store
*.swp
*.swo
.idea/
.vscode/
.worktrees/*

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Jupyter runtime files
.ipynb_checkpoints/

# Secrets and local configuration
.env
.env.*
!.env.example

# Logs and temporary files
*.log
!deliverables/week3/day12_13/source/results/raw_logs/**/*.log
!deliverables/week3/day14/source/results/formal/runner.log
!deliverables/week3/day14/source/results/smoke/runner.log
!deliverables/week3/day14/source/results/audit/*.log
!deliverables/week4/day19/source/results/remote_evidence/*.log
*.tmp
*.temp

# Model weights and downloaded model directories
*.safetensors
*.bin
*.pt
*.pth
models/
!models/
models/*
!models/README.md
logs/*
!logs/README.md
reports/week8/rendered/
reports/week8/rendered-*/
.venv-week8/
.cache/

# Generated archives
*.tar
*.tar.gz
*.zip

# Week 5 Day 26 reproducible external media and private blind mappings
deliverables/week5/day26/source/data/images/
deliverables/week5/day26/source/results/private_blind_key*.json

